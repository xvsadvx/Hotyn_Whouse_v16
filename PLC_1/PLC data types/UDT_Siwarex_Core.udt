TYPE "UDT_Siwarex_Core"
TITLE = Данные весового модуля Siwarex
VERSION : 0.1
//Описание:
//        Базовая структура для работы с весовыми модулями Siwarex CS.
//        Статусы развёрнуты в Bool-поля. Коды ошибок упакованы в Word.
//        Watchdog (Comm_Fault) формируется в FB_Map_Siwarex_Core.
//
//        Карта памяти:
//        +0  Weight_Gross_kg  Real    4 байта
//        +4  Weight_Net_kg    Real    4 байта
//        +8  Weight_Tare_kg   Real    4 байта
//        +12 Status           Struct  2 байта (16 бит)
//        +14 Err_Raw          Word    2 байта
//              Старший байт: b_OPR_ERR_MSG (операционные ошибки модуля)
//                Бит 7.0 — Перезапуск: ошибка RAM
//                Бит 7.1 — Перезапуск: watchdog
//                Бит 7.2 — Перезапуск: программная ошибка
//                Бит 7.3 — Переполнение при вычислении веса
//                Бит 7.4 — Ошибка параметров (переслать DS3/DS4)
//                Бит 7.5 — АЦП на пределе диапазона
//                Бит 7.6 — Обрыв/занижение напряжения датчика
//                Бит 7.7 — Неисправность АЦП
//              Младший байт: b_FB_ERR_CODE (ошибки драйвера FB SICS)
//                Бит 0.0 — DB недоступен / неверная длина
//                Бит 0.1 — Ошибка SFC58/SFC59 (RD_REC/WR_REC)
//                Бит 0.2 — Неверный номер команды или записи
//                Бит 0.3 — Lifebit: модуль не отвечает
//                Бит 0.4 — Нет чтения периферии в этом цикле
//                Бит 0.5 — Команда прервана при рестарте
//        +16 Cmd              Struct  2 байта (16 бит)
//        +18 Spare_Real_1     Real    4 байта
//        Итого: 22 байта
   STRUCT
      Weight_Gross_kg : Real;   // Брутто (полный вес)
      Weight_Net_kg : Real;   // Нетто (чистый вес продукта)
      Weight_Tare_kg : Real;   // Тара (вес пустой ёмкости) --- Статусы весов (2 байта = 16 бит) ---
      Status : Struct
         Standstill : Bool;   // Весы в покое (команды Zero/Tare разрешены)
         Limit_1 : Bool;   // Уставка 1 сработала
         Limit_2 : Bool;   // Уставка 2 сработала
         Tared : Bool;   // Весы затарированы (отображать NET)
         Quarter_D_Zero : Bool;   // Вес < ±0.25d (кнопка Zero разрешена)
         Scale_Calibrated : Bool;   // Модуль откалиброван (вес достоверен)
         Write_Protected : Bool;   // Перемычка 1-5 установлена (сервис)
         Limit_Max : Bool;   // Перегруз: выход за диапазон > 9d
         Fault_HW : Bool;   // Аппаратная ошибка модуля (b_OPR_ERR_MSG != 0)
         Fault_FB : Bool;   // Ошибка драйвера FB SICS (b_FB_ERR_CODE != 0)
         Fault : Bool;   // Ошибка FB OR HW
         Comm_Fault : Bool;   // Watchdog: нет обновления данных > 5 с
         Pad_1 : Bool;   // Выравнивание
         Pad_2 : Bool;   // Выравнивание
         Pad_3 : Bool;   // Выравнивание
         Pad_4 : Bool;   // Выравнивание --- Коды ошибок для инженерной диагностики ---
      END_STRUCT;
      Err_Raw : Word;   // Старший байт: b_OPR_ERR_MSG Младший байт: b_FB_ERR_CODE --- Команды с HMI (2 байта, обработка в отдельном FC) ---
      Cmd : Struct
         Zero : Bool;   // Установка нуля (только при Standstill + Quarter_D_Zero)
         Tare : Bool;   // Тарирование (только при Standstill)
         DeleteTare : Bool;   // Сброс тары
         ResetError : Bool;   // Сброс ошибки
         Pad_0_4 : Bool;   // Выравнивание
         Pad_0_5 : Bool;   // Выравнивание
         Pad_0_6 : Bool;   // Выравнивание
         Pad_0_7 : Bool;   // Выравнивание
         Pad_Byte : Byte;   // Резервный байт
      END_STRUCT;
      Spare_Real_1 : Real;   // Резерв
   END_STRUCT;

END_TYPE

